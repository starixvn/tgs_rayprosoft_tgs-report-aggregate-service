<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6e0b56f7-2fd7-4871-a0da-8008c6e68806</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	  <GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
	  <GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
	  <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
	  <DockerfileTag Condition="$(DockerfileTag) == ''">tgs-report-aggregate-service</DockerfileTag>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="10.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.14.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
    <PackageReference Include="Tgs.Logging" Version="0.0.13" />
    <PackageReference Include="Tgs.MessageQueue.Nats" Version="1.4.0" />
    <PackageReference Include="Tgs.MessageQueue.RabbitMQ" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.Report.Aggregate.Core\Tgs.Report.Aggregate.Core.csproj" />
    <ProjectReference Include="..\Tgs.Report.Aggregate.Domain\Tgs.Report.Aggregate.Domain.csproj" />
    <ProjectReference Include="..\Tgs.Report.Aggregate.Repository\Tgs.Report.Aggregate.Repository.csproj" />
  </ItemGroup>

</Project>
