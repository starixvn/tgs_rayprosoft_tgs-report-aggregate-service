		},
		"Docker": {
			"commandName": "Docker",
			"launchBrowser": true,
			"launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
			"publishAllPorts": true,
			"useSSL": true,
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Report-Aggregate-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			}
		}
	}
